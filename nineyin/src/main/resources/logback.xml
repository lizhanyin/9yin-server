<?xml version="1.0" encoding="UTF-8"?>
<!--
  九阴 Java 服务端日志（对齐参考端 logs/game-19061.current.log 的行为：服务自身落盘滚动日志）。
  文件基目录取 NINEYIN_SERVER_ROOT（启动 bat 注入）；未注入时退回工作目录。
  测试环境用 src/test/resources/logback-test.xml（仅控制台，不落盘）。
-->
<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy/MM/dd HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${NINEYIN_SERVER_ROOT:-.}/logs/nineyin-java.log</file>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{yyyy/MM/dd HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${NINEYIN_SERVER_ROOT:-.}/logs/nineyin-java.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>20MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>
